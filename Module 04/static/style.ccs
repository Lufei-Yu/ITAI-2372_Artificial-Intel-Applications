:root { color-scheme: light; font-family: Inter, Arial, sans-serif; color: #172033; background: #f3f6fb; }
* { box-sizing: border-box; }
body { margin: 0; }
.container { max-width: 980px; margin: 0 auto; padding: 36px 20px 48px; }
header { margin-bottom: 24px; }
.eyebrow { color: #3569b8; font-size: .78rem; font-weight: 800; letter-spacing: .15em; }
h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 8px 0; }
.subtitle { color: #596579; max-width: 650px; line-height: 1.6; }
.panel, .result-card { background: white; border: 1px solid #e0e6ef; border-radius: 16px; padding: 22px; box-shadow: 0 8px 28px rgba(31, 50, 81, .05); }
label { display: block; font-weight: 700; margin: 12px 0 8px; }
textarea, input { width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; font: inherit; background: #fff; }
textarea { resize: vertical; line-height: 1.5; }
button { margin-top: 16px; padding: 12px 20px; border: 0; border-radius: 10px; color: white; background: #2459a9; font-size: 1rem; font-weight: 700; cursor: pointer; }
button:hover { background: #194784; }
.hint, .small { color: #657187; font-size: .88rem; line-height: 1.5; }
.results { margin-top: 28px; }
.result-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.5fr); gap: 16px; }
.result-card h3 { margin-top: 0; }
.sentiment { display: inline-block; padding: 8px 12px; border-radius: 999px; font-weight: 800; text-transform: capitalize; background: #e9eef5; }
.sentiment.positive { color: #17603a; background: #e2f6e9; }
.sentiment.negative { color: #9b2929; background: #fde8e8; }
.sentiment.neutral { color: #735516; background: #fff3cf; }
.question-card { margin-top: 16px; }
details { margin-top: 18px; padding: 16px; background: #fff; border-radius: 12px; border: 1px solid #e0e6ef; overflow-wrap: anywhere; }
summary { cursor: pointer; font-weight: 700; }
footer { margin-top: 30px; padding-top: 18px; border-top: 1px solid #d9e0ea; color: #5e6879; font-size: .9rem; line-height: 1.6; }
@media (max-width: 700px) { .result-grid { grid-template-columns: 1fr; } .container { padding: 24px 14px; } }
